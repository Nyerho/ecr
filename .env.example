# Firebase web app configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Staged migration: leave false until the trusted backend is deployed and tested.
VITE_ECR_TRUSTED_COMMANDS_ENABLED=false
VITE_ECR_TRUSTED_API_URL=

# Trusted backend only. Never expose these as VITE_ variables.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Phase 2 retention policy (server-only; preview is non-destructive by default).
ECR_RETENTION_INCIDENT_DAYS=365
ECR_RETENTION_AUDIT_DAYS=730
ECR_RETENTION_NOTIFICATION_DAYS=30
ECR_RETENTION_DRAFT_DAYS=30

# Phase 3 private media provider (S3-compatible bucket; server-only).
ECR_MEDIA_BUCKET=
ECR_MEDIA_REGION=
ECR_MEDIA_ENDPOINT=
ECR_MEDIA_FORCE_PATH_STYLE=false
ECR_MEDIA_ACCESS_KEY_ID=
ECR_MEDIA_SECRET_ACCESS_KEY=

# Scanner must accept raw image bytes and return JSON: { "clean": true } or { "clean": false, "threat": "..." }.
# The API fails closed when this is blank or the scanner is unavailable.
ECR_MALWARE_SCANNER_URL=
