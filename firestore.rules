rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.role == 'citizen';
      allow read: if isOwner(uid) || isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId', 'jurisdictionId']));
      allow delete: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /incidents/{incidentId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid && request.resource.data.status == 'submitted';
      allow read: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /organizations/{organizationId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{auditId} {
      allow create: if isAdmin() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
